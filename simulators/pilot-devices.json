    "ST-04": {
      "driver": "opcua_v1",
      "protocol": "OPC UA TaskExecution",
      "note": "辊压冲切机：集成商按 ILCS TaskExecution 实现的 OPC UA 服务器",
      "credential_ref": "file:///run/secrets/ilcs/opcua/ilcs-client.json",
      "config": {
        "endpoint": "opc.tcp://opcua-sim-calender:4840/ilcs/",
        "security_policy": "Basic256Sha256",
        "security_mode": "SignAndEncrypt",
        "server_certificate": "/run/secrets/ilcs/opcua/SIM-CAL-01.crt",
        "application_uri": "urn:ilcs:client",
        "expected_device_id": "SIM-CAL-01",
        "request_timeout_sec": 10,
        "probe_interval_sec": 10
      }
    },
    "ST-05": {
      "driver": "composite_v1",
      "protocol": "组合工位",
      "note": "真空干燥箱（串口命令，经串口服务器）+ 分析天平（MT-SICS）",
      "config": {
        "request_timeout_sec": 10,
        "probe_interval_sec": 10,
        "routes": [
          {
            "name": "oven",
            "capabilities": [
              "cap.vacuum_dry"
            ],
            "driver": "line_command_v1",
            "protocol": "串口 / TCP 命令",
            "config": {
              "transport": {
                "kind": "tcp",
                "host": "line-sim-oven",
                "port": 4001
              },
              "encoding": "ascii",
              "write_terminator": "\r\n",
              "read_terminator": "\r\n",
              "request_timeout_sec": 3,
              "probe_interval_sec": 10,
              "identity": {
                "send": "*IDN?",
                "pattern": "^(?P<vendor>[^,]*),(?P<model>[^,]*),(?P<device_id>[^,]*),(?P<firmware>.*)$"
              },
              "ready": {
                "send": "REM?",
                "pattern": "^(?P<value>\\w+)$",
                "ok": [
                  "REMOTE"
                ]
              },
              "interlock": {
                "send": "DOOR?",
                "pattern": "^(?P<value>\\w+)$",
                "ok": [
                  "CLOSED"
                ]
              },
              "error_pattern": "^ERR",
              "capabilities": {
                "cap.vacuum_dry": {
                  "program": "VD-120",
                  "start": [
                    {
                      "send": "PROG {program}",
                      "expect": "^OK$"
                    },
                    {
                      "send": "SP {temp:.1f}",
                      "expect": "^OK$"
                    },
                    {
                      "send": "VAC {vacuum:.2f}",
                      "expect": "^OK$"
                    },
                    {
                      "send": "RUN",
                      "expect": "^OK$"
                    }
                  ]
                }
              },
              "status": {
                "send": "STAT?",
                "pattern": "^(?P<state>[A-Z]+)(,(?P<detail>.*))?$",
                "states": {
                  "IDLE": "idle",
                  "RUN": "running",
                  "HOLD": "held",
                  "DONE": "done",
                  "ALARM": "failed"
                }
              },
              "error_codes": {
                "E05": "干燥过程报警：温度偏差超限",
                "E07": "真空泵停机：干燥中断"
              },
              "actuals": [
                {
                  "send": "PV?",
                  "pattern": "^(?P<temp>[-\\d.]+),(?P<vacuum>[-\\d.]+)$"
                }
              ],
              "hold": [
                {
                  "send": "HOLD",
                  "expect": "^OK$"
                }
              ],
              "resume": [
                {
                  "send": "CONT",
                  "expect": "^OK$"
                }
              ],
              "abort": [
                {
                  "send": "STOP",
                  "expect": "^OK$"
                }
              ],
              "acknowledge": [
                {
                  "send": "ACK",
                  "expect": "^OK$"
                }
              ],
              "methods": [
                "VD-120",
                "VD-90"
              ],
              "expected_device_id": "SIM-OVEN-01"
            }
          },
          {
            "name": "balance",
            "capabilities": [
              "cap.weigh"
            ],
            "driver": "mt_sics_v1",
            "protocol": "MT-SICS",
            "config": {
              "transport": {
                "kind": "tcp",
                "host": "mtsics-sim-balance",
                "port": 4305
              },
              "request_timeout_sec": 3,
              "probe_interval_sec": 10,
              "expected_device_id": "SIM-BAL-01",
              "capabilities": {
                "cap.weigh": {
                  "action": "weigh",
                  "result": "mass",
                  "unit": "g",
                  "stable_timeout_sec": 15
                }
              }
            }
          }
        ]
      }
    },
    "ST-06": {
      "driver": "sila2_v1",
      "protocol": "SiLA 2",
      "config": {
        "host": "sila-sim-lh",
        "port": 50052,
        "ca_file": "/run/secrets/ilcs/sila/SIM-LH-01.crt",
