    "ST-01-A": {
      "driver": "sila2_v1",
      "protocol": "SiLA 2",
      "config": {
        "host": "sila-sim-slurry-a",
        "port": 50054,
        "ca_file": "/run/secrets/ilcs/sila/SIM-SLR-A.crt",
        "expected_device_id": "SIM-SLR-A",
        "request_timeout_sec": 10,
        "probe_interval_sec": 10
      },
      "note": "高通量匀浆工作站：厂家调度软件的 SiLA 2 服务（ILCS TaskExecution 特性）"
    },
    "ST-01-B": {
      "driver": "sql_table_v1",
      "protocol": "数据库中间表",
      "note": "高通量匀浆工作站 B：厂家调度软件经中间库（ILCS 中间库契约的作业表）对接",
      "config": {
        "url": "postgresql+psycopg2://exchange@sql-sim-exchange:5432/exchange",
        "device_id": "SIM-SLR-B",
        "jobs_table": "ilcs_jobs",
        "device_table": "ilcs_device",
        "heartbeat_stale_sec": 30,
        "request_timeout_sec": 10,
        "probe_interval_sec": 10
      }
    },
