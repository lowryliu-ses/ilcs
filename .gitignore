# Python / Node 依赖与缓存
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
*.tsbuildinfo

# 前端构建产物：部署时在开发机现场构建
dist/

# 秘密与部署机配置：只有 .env.example 进仓库
secrets/
deploy/.env
.env

# 运行数据：数据库备份、附件、迁移报告、补录清单都属于环境，不属于代码
/data/
api/data/
api/test_files/
output/

# 已不再支持的 SQLite 残留文件
*.db
*.db-wal
*.db-shm

# 本机工具
.DS_Store
.playwright-cli/
.claude/
