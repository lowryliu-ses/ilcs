{
  "note": "ProtoForge 的 OPC UA 温控 / 压力节点：读压力、温度、上下限报警，Setpoint 可写 0–10 bar；温控器设定温度（cap.tc_setpoint）：写 Temperature 节点、回读，只写设定值、没有启动信号，高报为真时判故障",
  "plugin": "opcua_map",
  "port": 50202,
  "simulator": true,
  "config_version": "r2",
  "device_id": "PF-OPCUA-PRESSURE",
  "config": {
    "endpoint": "opc.tcp://host.docker.internal:4840/protoforge",
    "security_policy": "None",
    "request_timeout_sec": 5,
    "connect_timeout_sec": 3,
    "points": {
      "pressure": {
        "node": "ns=2;s=Pressure",
        "unit": "bar",
        "label": "压力"
      },
      "temperature": {
        "node": "ns=2;s=Temperature",
        "unit": "℃",
        "label": "温度"
      },
      "alarm_high": {
        "node": "ns=2;s=AlarmHigh",
        "label": "高报",
        "value_type": "Boolean"
      },
      "alarm_low": {
        "node": "ns=2;s=AlarmLow",
        "label": "低报",
        "value_type": "Boolean"
      },
      "setpoint": {
        "node": "ns=2;s=Setpoint",
        "unit": "bar",
        "label": "压力设定",
        "writable": true,
        "min": 0,
        "max": 10
      }
    },
    "status": {
      "point": "alarm_high",
      "states": {
        "false": "idle",
        "true": "failed"
      }
    },
    "capabilities": {
      "cap.tc_setpoint": {
        "write": {
          "temp": "temperature"
        },
        "start": {
          "write_only": true
        },
        "idle_after_start": "done",
        "actuals": {
          "temp": "temperature"
        }
      }
    }
  },
  "supports": {
    "hold": false,
    "abort": false,
    "query": true,
    "dedup": true
  }
}
