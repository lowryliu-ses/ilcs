{
  "note": "ProtoForge 从站 2 的握手 PLC（devices/simulators/protoforge/ilcs-plc-scenario.json）；插件配置照抄 ILCS 工位 ST-PF-MB 的 modbus_map_v1 配置",
  "plugin": "modbus_map",
  "port": 50201,
  "simulator": true,
  "config_version": "r1",
  "supports": {
    "hold": false,
    "abort": false,
    "query": true,
    "dedup": true
  },
  "config": {
    "request_timeout_sec": 5,
    "connect_timeout_sec": 3,
    "start_timeout_sec": 15,
    "host": "host.docker.internal",
    "port": 5020,
    "unit_id": 2,
    "expected_device_id": "PF-MB-PLC-01",
    "points": {
      "state": {
        "table": "holding",
        "address": 0,
        "type": "uint16"
      },
      "sp": {
        "table": "holding",
        "address": 2,
        "type": "float32"
      },
      "pv": {
        "table": "holding",
        "address": 4,
        "type": "float32"
      },
      "error": {
        "table": "holding",
        "address": 6,
        "type": "uint16"
      },
      "serial": {
        "table": "holding",
        "address": 10,
        "type": "ascii",
        "length": 24
      },
      "model": {
        "table": "holding",
        "address": 50,
        "type": "ascii",
        "length": 24
      },
      "cmd_start": {
        "table": "coil",
        "address": 0,
        "type": "bool"
      },
      "cmd_ack": {
        "table": "coil",
        "address": 1,
        "type": "bool"
      }
    },
    "identity": {
      "device_id": "serial",
      "model": "model"
    },
    "capabilities": {
      "cap.plc_run": {
        "write": {
          "temp": "sp"
        },
        "start": {
          "point": "cmd_start",
          "value": true
        },
        "actuals": {
          "temp": "pv"
        }
      }
    },
    "status": {
      "point": "state",
      "states": {
        "0": "idle",
        "1": "running",
        "3": "done",
        "4": "failed"
      }
    },
    "error": {
      "point": "error",
      "codes": {}
    },
    "acknowledge": {
      "point": "cmd_ack",
      "value": true
    }
  }
}
