{
  "note": "模拟仪表 Keithley 2450（设备模块 devices/gateway/scpi-cell-meter 的 profile-keithley-2450.json，模拟容器 k2450-sim）；映射照抄模板 TPL-SCPI-K2450-OCV r1，只填了连接",
  "plugin": "line_command",
  "port": 50211,
  "simulator": true,
  "config_version": "r1",
  "supports": {
    "hold": false,
    "abort": false,
    "query": true,
    "dedup": true
  },
  "config": {
    "transport": {
      "kind": "tcp",
      "host": "k2450-sim",
      "port": 5025
    },
    "write_terminator": "\n",
    "read_terminator": "\n",
    "connect_timeout_sec": 3,
    "request_timeout_sec": 5,
    "idle_after_start": "unknown",
    "identity": {
      "send": "*IDN?",
      "pattern": "^(?P<vendor>[^,]*),\\s*(?:MODEL )?(?P<model>[^,]*),\\s*(?P<device_id>[^,]*),\\s*(?P<firmware>.*)$"
    },
    "ready": {
      "send": "*LANG?",
      "pattern": "^(?P<value>\\w+)$",
      "ok": [
        "SCPI"
      ]
    },
    "error_pattern": "^[-+]?[1-9]\\d*,",
    "methods": [
      {
        "program": "OCV",
        "name": "开路电压（源 0 A、四线测电压）",
        "capability": "cap.cell_check"
      }
    ],
    "capabilities": {
      "cap.cell_check": {
        "start": [
          {
            "send": "*CLS",
            "reply": false
          },
          {
            "send": ":OUTP:CURR:SMOD HIMP",
            "reply": false
          },
          {
            "send": ":OUTP OFF",
            "reply": false
          },
          {
            "send": ":ROUT:TERM FRON",
            "reply": false
          },
          {
            "send": ":SOUR:FUNC CURR",
            "reply": false
          },
          {
            "send": ":SOUR:VOLT:PROT PROT20",
            "reply": false
          },
          {
            "send": ":SOUR:CURR:RANG:AUTO ON",
            "reply": false
          },
          {
            "send": ":SOUR:CURR 0",
            "reply": false
          },
          {
            "send": ":SOUR:CURR:VLIM 10",
            "reply": false
          },
          {
            "send": ":SENS:FUNC \"VOLT\"",
            "reply": false
          },
          {
            "send": ":SENS:VOLT:RANG 20",
            "reply": false
          },
          {
            "send": ":SENS:VOLT:NPLC 1",
            "reply": false
          },
          {
            "send": ":SENS:VOLT:RSEN ON",
            "reply": false
          },
          {
            "send": ":SENS:COUN 1",
            "reply": false
          },
          {
            "send": ":SYST:ERR?",
            "expect": "^[-+]?0+,"
          },
          {
            "send": ":OUTP ON",
            "reply": false,
            "wait_ms": 50
          },
          {
            "send": ":SYST:ERR?",
            "expect": "^[-+]?0+,"
          },
          {
            "send": ":OUTP?",
            "expect": "^(1|ON)$"
          },
          {
            "send": ":READ? \"defbuffer1\"",
            "motion": true,
            "reject": "[eE]\\+?37"
          },
          {
            "send": ":OUTP OFF",
            "reply": false
          }
        ],
        "result": {
          "pattern": "^(?P<ocv_V>[-+]?\\d+(?:\\.\\d*)?(?:[eE][-+]?\\d+)?)$"
        }
      }
    },
    "status": {
      "send": ":TRAC:ACT? \"defbuffer1\"",
      "pattern": "^\\+?0*(?P<state>\\d)\\d*$",
      "states": {
        "0": "idle",
        "1": "done",
        "2": "done",
        "3": "done",
        "4": "done",
        "5": "done",
        "6": "done",
        "7": "done",
        "8": "done",
        "9": "done"
      }
    },
    "actuals": {
      "send": ":FETC? \"defbuffer1\"",
      "pattern": "^(?P<ocv_V>[-+]?\\d+(?:\\.\\d*)?(?:[eE][-+]?\\d+)?)$"
    },
    "acknowledge": [
      {
        "send": ":OUTP OFF",
        "reply": false
      },
      {
        "send": ":TRAC:CLE \"defbuffer1\"",
        "reply": false
      }
    ]
  }
}
