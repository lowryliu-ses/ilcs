{
  "note": "模拟仪表 Keithley 2400（设备模块 devices/gateway/scpi-cell-meter 的 profile-keithley-2400.json，模拟容器 k2400-sim）；映射照抄模板 TPL-SCPI-K2400-OCV r1，只填了连接",
  "plugin": "line_command",
  "port": 50212,
  "simulator": true,
  "config_version": "r1",
  "supports": {
    "hold": false,
    "abort": false,
    "query": true,
    "dedup": true
  },
  "config": {
    "transport": {
      "kind": "serial",
      "port": "socket://k2400-sim:4001",
      "baudrate": 9600
    },
    "write_terminator": "\r",
    "read_terminator": "\r",
    "connect_timeout_sec": 3,
    "request_timeout_sec": 5,
    "inter_command_delay_ms": 20,
    "idle_after_start": "unknown",
    "identity": {
      "send": "*IDN?",
      "pattern": "^(?P<vendor>[^,]*),\\s*(?:MODEL )?(?P<model>[^,]*),\\s*(?P<device_id>[^,]*),\\s*(?P<firmware>.*)$"
    },
    "error_pattern": "^[-+]?[1-9]\\d*,",
    "methods": [
      {
        "program": "OCV",
        "name": "开路电压（源 0 A、四线测电压）",
        "capability": "cap.cell_check"
      }
    ],
    "capabilities": {
      "cap.cell_check": {
        "start": [
          {
            "send": "*CLS",
            "reply": false
          },
          {
            "send": ":OUTP:SMOD HIMP",
            "reply": false
          },
          {
            "send": ":OUTP OFF",
            "reply": false
          },
          {
            "send": ":SOUR:CLE:AUTO OFF",
            "reply": false
          },
          {
            "send": ":ROUT:TERM FRON",
            "reply": false
          },
          {
            "send": ":SOUR:FUNC CURR",
            "reply": false
          },
          {
            "send": ":SOUR:CURR:MODE FIX",
            "reply": false
          },
          {
            "send": ":SOUR:CURR:RANG:AUTO ON",
            "reply": false
          },
          {
            "send": ":SOUR:CURR:LEV 0",
            "reply": false
          },
          {
            "send": ":SENS:FUNC:CONC OFF",
            "reply": false
          },
          {
            "send": ":SENS:FUNC \"VOLT\"",
            "reply": false
          },
          {
            "send": ":SENS:VOLT:PROT 10",
            "reply": false
          },
          {
            "send": ":SENS:VOLT:RANG 20",
            "reply": false
          },
          {
            "send": ":SENS:VOLT:NPLC 1",
            "reply": false
          },
          {
            "send": ":SYST:RSEN ON",
            "reply": false
          },
          {
            "send": ":FORM:ELEM VOLT",
            "reply": false
          },
          {
            "send": ":TRIG:COUN 1",
            "reply": false
          },
          {
            "send": ":ARM:COUN 1",
            "reply": false
          },
          {
            "send": ":TRAC:FEED:CONT NEV",
            "reply": false
          },
          {
            "send": ":TRAC:CLE",
            "reply": false
          },
          {
            "send": ":TRAC:FEED SENS",
            "reply": false
          },
          {
            "send": ":TRAC:POIN 1",
            "reply": false
          },
          {
            "send": ":TRAC:FEED:CONT NEXT",
            "reply": false
          },
          {
            "send": ":SYST:ERR?",
            "expect": "^[-+]?0+,"
          },
          {
            "send": ":OUTP ON",
            "reply": false,
            "wait_ms": 50
          },
          {
            "send": ":SYST:ERR?",
            "expect": "^[-+]?0+,"
          },
          {
            "send": ":OUTP?",
            "expect": "^(1|ON)$"
          },
          {
            "send": ":READ?",
            "motion": true,
            "reject": "[eE]\\+?37"
          },
          {
            "send": ":OUTP OFF",
            "reply": false
          }
        ],
        "result": {
          "pattern": "^(?P<ocv_V>[-+]?\\d+(?:\\.\\d*)?(?:[eE][-+]?\\d+)?)$"
        }
      }
    },
    "status": {
      "send": ":TRAC:POIN:ACT?",
      "pattern": "^\\+?0*(?P<state>\\d)\\d*$",
      "states": {
        "0": "idle",
        "1": "done",
        "2": "done",
        "3": "done",
        "4": "done",
        "5": "done",
        "6": "done",
        "7": "done",
        "8": "done",
        "9": "done"
      }
    },
    "actuals": {
      "send": ":TRAC:DATA?",
      "pattern": "^(?P<ocv_V>[-+]?\\d+(?:\\.\\d*)?(?:[eE][-+]?\\d+)?)$"
    },
    "acknowledge": [
      {
        "send": ":OUTP OFF",
        "reply": false
      },
      {
        "send": ":TRAC:FEED:CONT NEV",
        "reply": false
      },
      {
        "send": ":TRAC:CLE",
        "reply": false
      }
    ]
  }
}
