{
  "note": "ProtoForge 的 HTTP 设备：路径与字段要对着本机 ProtoForge 核对后再改名为 .json 启用；ProtoForge 的 8080 只在它自己的网络里，驱动宿主要能连到（把 ProtoForge 接进 ilcs_backend，或把 8080 映射出来）",
  "plugin": "rest_map",
  "port": 50203,
  "simulator": true,
  "config_version": "r1",
  "device_id": "PF-HTTP-01",
  "config": {
    "base_url": "http://protoforge:8080",
    "allow_insecure_http": true,
    "request_timeout_sec": 5,
    "points": {
      "temperature": {
        "path": "/temperature",
        "field": "value",
        "unit": "℃",
        "label": "温度"
      }
    }
  }
}
