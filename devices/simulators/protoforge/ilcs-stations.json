{
  "_说明": "ProtoForge 场景 ilcs-plc-scenario.json 里那台 Modbus PLC 在 ILCS「工位与接入 → 设备连接」的配置：驱动、协议、配置照抄，支持标志：保持、终止都关（PLC 没有这两个信号）。ProtoForge 的 5020 映射在宿主机 127.0.0.1 上，ILCS 容器经 host.docker.internal 连它；host.docker.internal 要加进 deploy/.env 的 ILCS_ADAPTER_ALLOWED_HOSTS。",
  "stations": {
    "ST-PF-MB": {
      "name": "ProtoForge PLC（Modbus TCP）",
      "driver": "modbus_map_v1",
      "protocol": "Modbus TCP 点表",
      "config": {
        "request_timeout_sec": 5,
        "connect_timeout_sec": 3,
        "probe_interval_sec": 10,
        "start_timeout_sec": 15,
        "host": "host.docker.internal",
        "port": 5020,
        "unit_id": 2,
        "expected_device_id": "PF-MB-PLC-01",
        "points": {
          "state": {
            "table": "holding",
            "address": 0,
            "type": "uint16"
          },
          "sp": {
            "table": "holding",
            "address": 2,
            "type": "float32"
          },
          "pv": {
            "table": "holding",
            "address": 4,
            "type": "float32"
          },
          "error": {
            "table": "holding",
            "address": 6,
            "type": "uint16"
          },
          "serial": {
            "table": "holding",
            "address": 10,
            "type": "ascii",
            "length": 24
          },
          "model": {
            "table": "holding",
            "address": 50,
            "type": "ascii",
            "length": 24
          },
          "cmd_start": {
            "table": "coil",
            "address": 0,
            "type": "bool"
          },
          "cmd_ack": {
            "table": "coil",
            "address": 1,
            "type": "bool"
          }
        },
        "identity": {
          "device_id": "serial",
          "model": "model"
        },
        "capabilities": {
          "cap.plc_run": {
            "write": {
              "temp": "sp"
            },
            "start": {
              "point": "cmd_start",
              "value": true
            },
            "actuals": {
              "temp": "pv"
            }
          }
        },
        "status": {
          "point": "state",
          "states": {
            "0": "idle",
            "1": "running",
            "3": "done",
            "4": "failed"
          }
        },
        "error": {
          "point": "error",
          "codes": {}
        },
        "acknowledge": {
          "point": "cmd_ack",
          "value": true
        },
        "acceptance": {
          "capability": "cap.plc_run",
          "params": {
            "temp": 60
          }
        }
      }
    }
  },
  "supports": {
    "hold": false,
    "abort": false,
    "query": true,
    "dedup": true
  }
}
