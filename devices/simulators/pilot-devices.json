{
  "_说明": "试点设备预设：每个示例工位接哪种驱动、连哪台模拟设备（deploy/docker-compose.yml 的 pilot profile）。由 scripts/configure-pilot-adapters.py apply --preset 使用（缺省读这个文件）。ILCS 只经 sila2_v1、http_json_v1 接设备：PLC 点表、任务契约、REST、串口命令这几类协议的设备在驱动宿主（devices/host）里登记，不在这里。接真机时按现场地址、证书改写，不要直接照搬模拟设备的编号与地址。simulator_control 是模拟设备的统一控制口（接入验收的故障项目与动作计数用），接真机时删掉。",
  "stations": {
    "ST-01-A": {
      "driver": "sila2_v1",
      "protocol": "SiLA 2",
      "config": {
        "host": "sila-sim-slurry-a",
        "port": 50054,
        "ca_file": "/run/secrets/ilcs/sila/SIM-SLR-A.crt",
        "expected_device_id": "SIM-SLR-A",
        "request_timeout_sec": 10,
        "probe_interval_sec": 10,
        "simulator_control": {
          "url": "http://sila-sim-slurry-a:9900",
          "token_ref": "file:///run/secrets/ilcs/simctl/SIM-SLR-A.token"
        }
      },
      "note": "高通量匀浆工作站：厂家调度软件的 SiLA 2 服务（ILCS TaskExecution 特性）"
    },
    "ST-06": {
      "driver": "sila2_v1",
      "protocol": "SiLA 2",
      "config": {
        "host": "sila-sim-lh",
        "port": 50052,
        "ca_file": "/run/secrets/ilcs/sila/SIM-LH-01.crt",
        "expected_device_id": "SIM-LH-01",
        "request_timeout_sec": 10,
        "probe_interval_sec": 10,
        "simulator_control": {
          "url": "http://sila-sim-lh:9900",
          "token_ref": "file:///run/secrets/ilcs/simctl/SIM-LH-01.token"
        }
      },
      "note": "手套箱注液工作站：SiLA 2 服务（ILCS TaskExecution 特性）"
    },
    "ST-07": {
      "driver": "http_json_v1",
      "protocol": "HTTPS JSON（厂家 SDK 接口服务）",
      "channels": 8,
      "note": "充放电测试柜：厂家 Windows SDK 由接口服务包成 ILCS 网关契约",
      "credential_ref": "file:///run/secrets/ilcs/gateway/SIM-CYC-01.token",
      "config": {
        "base_url": "https://gateway-sim-cycler:8443/api/v1",
        "ca_file": "/run/secrets/ilcs/gateway/SIM-CYC-01.crt",
        "verify_tls": true,
        "expected_device_id": "SIM-CYC-01",
        "heartbeat_mode": "probe",
        "request_timeout_sec": 10,
        "probe_interval_sec": 10,
        "simulator_control": {
          "url": "http://gateway-sim-cycler:9900",
          "token_ref": "file:///run/secrets/ilcs/simctl/SIM-CYC-01.token"
        }
      }
    }
  }
}
