{
  "format": "ilcs-device-template/1",
  "code": "TPL-SCPI-K2450-OCV",
  "revision": 1,
  "name": "Keithley 2450 电芯开路电压（SCPI，LAN）",
  "model": "2450",
  "vendor": "Keithley",
  "driver": "line_command_v1",
  "protocol": "SCPI（TCP 5025）",
  "version": "scpi-cell-meter 0.1",
  "config": {
    "write_terminator": "\n",
    "read_terminator": "\n",
    "connect_timeout_sec": 3,
    "request_timeout_sec": 5,
    "probe_interval_sec": 10,
    "idle_after_start": "unknown",
    "identity": {
      "send": "*IDN?",
      "pattern": "^(?P<vendor>[^,]*),\\s*(?:MODEL )?(?P<model>[^,]*),\\s*(?P<device_id>[^,]*),\\s*(?P<firmware>.*)$"
    },
    "ready": {"send": "*LANG?", "pattern": "^(?P<value>\\w+)$", "ok": ["SCPI"]},
    "error_pattern": "^[-+]?[1-9]\\d*,",
    "methods": [{"program": "OCV", "name": "开路电压（源 0 A、四线测电压）", "capability": "cap.cell_check"}],
    "capabilities": {
      "cap.cell_check": {
        "start": [
          {"send": "*CLS", "reply": false},
          {"send": ":OUTP:CURR:SMOD HIMP", "reply": false},
          {"send": ":OUTP OFF", "reply": false},
          {"send": ":ROUT:TERM FRON", "reply": false},
          {"send": ":SOUR:FUNC CURR", "reply": false},
          {"send": ":SOUR:VOLT:PROT PROT20", "reply": false},
          {"send": ":SOUR:CURR:RANG:AUTO ON", "reply": false},
          {"send": ":SOUR:CURR 0", "reply": false},
          {"send": ":SOUR:CURR:VLIM 10", "reply": false},
          {"send": ":SENS:FUNC \"VOLT\"", "reply": false},
          {"send": ":SENS:VOLT:RANG 20", "reply": false},
          {"send": ":SENS:VOLT:NPLC 1", "reply": false},
          {"send": ":SENS:VOLT:RSEN ON", "reply": false},
          {"send": ":SENS:COUN 1", "reply": false},
          {"send": ":SYST:ERR?", "expect": "^[-+]?0+,"},
          {"send": ":OUTP ON", "reply": false, "wait_ms": 50},
          {"send": ":SYST:ERR?", "expect": "^[-+]?0+,"},
          {"send": ":OUTP?", "expect": "^(1|ON)$"},
          {"send": ":READ? \"defbuffer1\"", "motion": true, "reject": "[eE]\\+?37"},
          {"send": ":OUTP OFF", "reply": false}
        ],
        "result": {"pattern": "^(?P<ocv_V>[-+]?\\d+(?:\\.\\d*)?(?:[eE][-+]?\\d+)?)$"}
      }
    },
    "status": {
      "send": ":TRAC:ACT? \"defbuffer1\"",
      "pattern": "^\\+?0*(?P<state>\\d)\\d*$",
      "states": {
        "0": "idle",
        "1": "done",
        "2": "done",
        "3": "done",
        "4": "done",
        "5": "done",
        "6": "done",
        "7": "done",
        "8": "done",
        "9": "done"
      }
    },
    "actuals": {"send": ":FETC? \"defbuffer1\"", "pattern": "^(?P<ocv_V>[-+]?\\d+(?:\\.\\d*)?(?:[eE][-+]?\\d+)?)$"},
    "acknowledge": [{"send": ":OUTP OFF", "reply": false}, {"send": ":TRAC:CLE \"defbuffer1\"", "reply": false}]
  },
  "connection": {
    "transport": {"kind": "tcp", "host": "keithley-2450.lab.internal", "port": 5025},
    "expected_device_id": "<仪器序列号>"
  },
  "supports": {"hold": false, "abort": false, "query": true, "dedup": true},
  "acceptance": {"capability": "cap.cell_check", "params": {}},
  "note": "设备模块 devices/gateway/scpi-cell-meter（映射模块，没有网关代码）：Keithley 2450 SourceMeter 走 LAN 原始套接字（TCP 5025，SCPI 命令集，结束符 LF），源 0 A、四线测电压，读电芯开路电压 ocv_V（V），不测内阻。一条指令测一颗电芯：配置 → 查错误队列 → 开输出（关断状态 HIMP，输出只在测量时开着）→ :READ? 的回复就是结果、当场完成 → 关输出。测量是即时动作：没有可保持、可终止的在途作业；回复丢了按 defbuffer1 里有没有新读数找回结论（质量 uncertain）。缺省电压限值 10 V、过压保护 20 V、20 V 量程、前面板端子、四线：被测电压高于 10 V、接后面板三同轴、两线夹具都要改模板。仪表要在 SCPI 命令集（*LANG SCPI），否则判未就绪。验收用 cap.cell_check（无参数）：动作级验收时夹具上放一颗参考电芯。",
  "state": "draft",
  "digest": "sha256:3866da0fb59b301c537428a16a71aff8f37ca19ce3ddb2f746df7b3c917d2149"
}
