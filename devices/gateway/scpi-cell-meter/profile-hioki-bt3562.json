{
  "format": "ilcs-device-template/1",
  "code": "TPL-SCPI-BT3562-ACIR",
  "revision": 1,
  "name": "Hioki BT3562 系列电芯交流内阻与电压",
  "model": "BT3562",
  "vendor": "Hioki",
  "driver": "line_command_v1",
  "protocol": "Hioki 通信命令（TCP 23 / RS-232C）",
  "version": "scpi-cell-meter 0.1",
  "config": {
    "write_terminator": "\r\n",
    "read_terminator": "\r\n",
    "connect_timeout_sec": 3,
    "request_timeout_sec": 5,
    "inter_command_delay_ms": 10,
    "probe_interval_sec": 10,
    "idle_after_start": "unknown",
    "identity": {
      "send": "*IDN?",
      "pattern": "^(?P<vendor>[^,]*),\\s*(?P<model>[^,]*),\\s*(?P<serial>[^,]*),\\s*(?P<firmware>.*)$"
    },
    "methods": [{"program": "ACIR-OCV", "name": "1 kHz 交流内阻 + 开路电压（ΩV 模式）", "capability": "cap.cell_check"}],
    "capabilities": {
      "cap.cell_check": {
        "start": [
          {"send": "*CLS", "reply": false},
          {"send": ":ESE0 1", "reply": false},
          {"send": ":SYST:HEAD OFF", "reply": false},
          {"send": ":FUNC RV", "reply": false},
          {"send": ":AUT OFF", "reply": false},
          {"send": ":RES:RANG 300E-3", "reply": false},
          {"send": ":VOLT:RANG 6", "reply": false},
          {"send": ":SAMP:RATE MED", "reply": false},
          {"send": ":TRIG:SOUR IMM", "reply": false},
          {"send": ":INIT:CONT OFF", "reply": false},
          {"send": "*ESR?", "expect": "^\\+?0$", "wait_ms": 100},
          {"send": ":READ?", "motion": true, "reject": "E\\+(?:[5-9]|\\d\\d)"}
        ],
        "result": {"pattern": "^(?P<ir_mohm>\\d+\\.\\d+)E-3,\\s*(?P<ocv_V>-?\\d+\\.\\d+E\\+0)$"}
      }
    },
    "status": {
      "send": "*STB?",
      "pattern": "^\\d*(?P<state>\\d)$",
      "states": {
        "0": "idle",
        "1": "done",
        "2": "idle",
        "3": "done",
        "4": "idle",
        "5": "done",
        "6": "idle",
        "7": "done",
        "8": "idle",
        "9": "done"
      }
    },
    "actuals": {"send": ":FETC?", "pattern": "^(?P<ir_mohm>\\d+\\.\\d+)E-3,\\s*(?P<ocv_V>-?\\d+\\.\\d+E\\+0)$"},
    "acknowledge": [{"send": ":INIT:CONT OFF", "reply": false}, {"send": "*CLS", "reply": false}]
  },
  "connection": {"transport": {"kind": "tcp", "host": "hioki-bt3562.lab.internal", "port": 23}},
  "supports": {"hold": false, "abort": false, "query": true, "dedup": true},
  "acceptance": {"capability": "cap.cell_check", "params": {}},
  "note": "设备模块 devices/gateway/scpi-cell-meter（映射模块，没有网关代码）：Hioki BT3562 系列电池测试仪（BT3561A / BT3562A / BT3563A 走 LAN，缺省命令端口 23；BT3562 / BT3563 只有 RS-232C，9600 8N1、结束符 CR+LF；GP-IB 不支持）。ΩV 模式一次测 1 kHz 交流内阻与直流电压：配置（300 mΩ / 6 V 固定档、中速、内部触发、关连续测量）→ *ESR? 查有没有命令 / 执行错误 → :READ? 的回复就是结果、当场完成（:ESE0 1 让测量结束位汇总到 *STB? 的 bit0）。输出 ir_mohm（mΩ：mΩ 档回的是 xxx.xxE-3，正则只取尾数，换到 3 Ω 以上的档要改正则）与 ocv_V（V）。超量程（±OF）、测量异常（探针没接触上）明确失败。测量是即时动作：没有可保持、可终止的在途作业；回复丢了按 *STB? 的测量结束位找回结论（质量 uncertain）。*IDN? 的序列号位固定是 0，不能用 expected_device_id 防接错，按地址 / 串口口位区分。验收用 cap.cell_check（无参数）：动作级验收时夹具上放一颗参考电芯。",
  "state": "draft",
  "digest": "sha256:917cbb4172eaec74f705eef1ac1cf008358707145b66fd623e16a991548ff5bb"
}
