{
  "device_id": "EL-D-STIR-01",
  "model": "Unichiller 012",
  "vendor": "Huber",
  "chiller": {
    "kind": "huber",
    "name": "制冷搅拌冷浴",
    "link": {"kind": "serial", "port": "COM3", "baudrate": 9600, "bytesize": 8, "parity": "N", "stopbits": 1},
    "min_c": -20,
    "max_c": 25,
    "tolerance_c": 0.5,
    "settle_sec": 60,
    "reach_timeout_sec": 3600,
    "after": "keep",
    "standby_c": 20
  },
  "capabilities": {"thermostat": "cap.thermostat", "stir": "cap.ely.stir"},
  "stirrers": {
    "1": {"name": "左前", "link": {"kind": "serial", "port": "COM5"}, "max_rpm": 1500, "min_rpm": 50},
    "2": {"name": "右前", "link": {"kind": "serial", "port": "COM6"}, "max_rpm": 1500},
    "3": {"name": "左后", "link": {"kind": "serial", "port": "rfc2217://192.168.10.31:4003"}, "max_rpm": 1500},
    "4": {"name": "右后", "link": {"kind": "tcp", "host": "192.168.10.31", "port": 4004, "timeout_sec": 2}, "max_rpm": 1500}
  },
  "auto_position": false,
  "programs": {
    "CHILL-CHECK": {"name": "控温 20 ℃ 保持 1 秒（接入验收用）", "action": "thermostat"},
    "STIR-CHILL": {"name": "加料后制冷搅拌", "action": "stir"},
    "STIR-COLD": {"name": "冷藏搅拌", "action": "stir"}
  },
  "default_program": "CHILL-CHECK",
  "poll_sec": 2,
  "lost_after_sec": 30
}
