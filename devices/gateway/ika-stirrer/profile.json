{
  "format": "ilcs-device-template/1",
  "code": "TPL-IKA-STIRRER",
  "revision": 1,
  "name": "IKA 磁力加热搅拌器（NAMUR 串口网关）",
  "model": "RCT digital",
  "vendor": "IKA",
  "driver": "http_json_v1",
  "protocol": "HTTPS JSON（IKA NAMUR 串口网关）",
  "version": "ika-stirrer 0.1",
  "config": {
    "verify_tls": true,
    "heartbeat_mode": "probe",
    "connect_timeout_sec": 3,
    "request_timeout_sec": 10,
    "probe_interval_sec": 10,
    "paths": {
      "health": "/health",
      "submit": "/commands",
      "query": "/commands/{command_id}",
      "hold": "/commands/{command_id}/hold",
      "abort": "/commands/{command_id}/abort"
    },
    "idempotency_header": "Idempotency-Key"
  },
  "connection": {
    "base_url": "https://ika-stirrer-gw.lab.internal:8443/api/v1",
    "ca_file": "/run/secrets/ilcs/gateway/<设备编号>.crt",
    "expected_device_id": "<设备编号>"
  },
  "supports": {
    "hold": false,
    "abort": true,
    "query": true,
    "dedup": true
  },
  "acceptance": {
    "capability": "cap.ely.stir",
    "params": {
      "temp": 40,
      "time": 2,
      "rpm": 300,
      "position": 1
    }
  },
  "note": "设备模块 devices/gateway/ika-stirrer：网关跑在接加热板的那台电脑上，经 NAMUR 串口命令（9600 7E1）控制 IKA 磁力加热搅拌器（RCT digital、C-MAG HS 7 control 等），一个位置一块板、一瓶；按 ILCS 指令号去重、可按指令号查询。指令参数 temp（℃）、time（s）、rpm、position：单瓶直接给，或逐孔 wells {孔位: {temp, time, rpm, position}}（工位按样本计通道，放瓶的人工步骤按样本记位置、前馈到这一步）。只能加热、不能制冷：低于室温的温度一律拒绝。计时在网关里，到点就停，停止确认之后才报完成；不做保持。验收用位置 1、40 ℃、2 秒、300 rpm：动作级验收时位置 1 放一个装水、带搅拌子的验收瓶。凭据是网关令牌文件（credential_ref）。",
  "state": "draft",
  "digest": "sha256:dab97078a12ebe017020ea095daf6c802f8516432dd7e06bd79b51172dbb382a"
}
