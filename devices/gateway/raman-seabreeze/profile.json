{
  "format": "ilcs-device-template/1",
  "code": "TPL-RAMAN-SEABREEZE",
  "revision": 1,
  "name": "拉曼光谱仪（Ocean Insight · seabreeze 网关）",
  "model": "QE Pro",
  "vendor": "Ocean Insight",
  "driver": "http_json_v1",
  "protocol": "HTTPS JSON（seabreeze 光谱仪网关）",
  "version": "raman-seabreeze 0.1",
  "config": {
    "verify_tls": true,
    "heartbeat_mode": "probe",
    "connect_timeout_sec": 3,
    "request_timeout_sec": 10,
    "probe_interval_sec": 10,
    "paths": {
      "health": "/health",
      "submit": "/commands",
      "query": "/commands/{command_id}",
      "hold": "/commands/{command_id}/hold",
      "abort": "/commands/{command_id}/abort"
    },
    "idempotency_header": "Idempotency-Key"
  },
  "connection": {
    "base_url": "https://raman-gw.lab.internal:8443/api/v1",
    "ca_file": "/run/secrets/ilcs/gateway/<设备编号>.crt",
    "expected_device_id": "<设备编号>"
  },
  "supports": {
    "hold": false,
    "abort": true,
    "query": true,
    "dedup": true
  },
  "acceptance": {
    "capability": "cap.ely.raman",
    "params": {
      "repeats": 1
    }
  },
  "note": "设备模块 devices/gateway/raman-seabreeze：网关跑在光谱仪 USB 插着的那台电脑上，经 python-seabreeze 采谱；按 ILCS 指令号去重、可按指令号查询。一条指令 = 在测量位上采 repeats 张谱取平均，回报 spectrum（{x: 拉曼位移 cm-1, y: 计数}）与 max_counts、saturated；积分时间按设备方法的程序（网关配置的 programs），能力登记了 integration_ms 时指令也可以带。单测量位：wells 只能有一瓶，多瓶按瓶分开下发。激光由外部开关与联锁，网关不控制激光。采谱停不在半截，不做保持。验收跑 default_program（设成短积分的程序），采谱不消耗样品。凭据是网关令牌文件（credential_ref）。",
