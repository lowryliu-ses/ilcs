# 部署配置样例。复制成 deploy/.env 再改；.env 不进版本库，也不能被 rsync --delete 带走。

# 数据库。只支持 PostgreSQL（Compose 内置 PG 16）；其他连接串在配置加载时即被拒绝。
POSTGRES_DB=ilcs
POSTGRES_USER=ilcs
POSTGRES_PASSWORD=__CHANGE_ME_DB_PASSWORD__
ILCS_DATABASE_URL=postgresql+psycopg2://ilcs:__CHANGE_ME_DB_PASSWORD__@db:5432/ilcs

# API 与执行器各自有连接池；总连接上限需按副本数核算。
ILCS_DB_POOL_SIZE=10
ILCS_DB_MAX_OVERFLOW=20
ILCS_DB_POOL_TIMEOUT_SEC=30
ILCS_DB_POOL_RECYCLE_SEC=1800

# 令牌与签名密钥。上线必须换掉，换了之后现有会话失效。
ILCS_ENVIRONMENT=production
ILCS_SECRET_KEY=__CHANGE_ME__
# 与令牌密钥独立；轮换令牌密钥不应导致全部账号口令失效。
ILCS_PASSWORD_PEPPER=__CHANGE_ME_PASSWORD_PEPPER__
# 仅首次 `seed --master-only` 使用；生成的账号首次登录会被强制改密。
# 播种成功后立即从正式 .env 删除/清空本项，不要把临时口令长期留在服务器。
ILCS_INITIAL_PASSWORD=__CHANGE_ME_INITIAL_PASSWORD__

# 文件存储。放持久卷，不放前端静态目录。
ILCS_FILE_ROOT=/data/files
# 上限要与 nginx 的 client_max_body_size 一起改，否则大文件在网关静默失败。
ILCS_FILE_MAX_BYTES=20971520
# 上传后未形成正式业务引用的暂存文件保留 24 小时；执行器每小时最多清理 100 个/组织。
ILCS_FILE_ORPHAN_RETENTION_HOURS=24
ILCS_FILE_CLEANUP_INTERVAL_SEC=3600
ILCS_FILE_CLEANUP_BATCH_SIZE=100

# 真实设备网关只允许连接这些主机，禁止 *。凭据文件必须挂在受控只读目录下。
ILCS_ADAPTER_ALLOWED_HOSTS=instrument-gateway.lab.internal,10.20.1.31
ILCS_ADAPTER_CREDENTIAL_ROOT=/run/secrets/ilcs

# 前端来源。内网部署填实际入口。
ILCS_WEB_BIND=0.0.0.0
ILCS_CORS_ORIGINS=http://10.10.106.51:8090

# 后台推进周期。到期的等待事件在两个周期内被领取。
ILCS_ADVANCE_POLL_SEC=5
ILCS_EXECUTOR_POLL_SEC=5
# 正式环境不允许模拟心跳，也不允许模拟适配器执行指令：设备在线状态必须由设备自己上报。
# 设为 1 会让 API 健康检查返回 configuration_error、执行器拒绝启动。
ILCS_EXECUTOR_SIMULATE_HEARTBEAT=0
# 执行器超过这么久没有上报存活，执行门关闭。正式环境必须大于 0。
ILCS_EXECUTOR_STALE_SEC=60

# 历史数据迁移的组织归属。确认不了归属时指向一个没有成员的受限组织。
ILCS_MIGRATION_ORG_ID=ORG-001
ILCS_MIGRATION_ORG_CODE=MAIN
ILCS_MIGRATION_ORG_NAME=本部电池实验室
ILCS_MIGRATION_ORG_TIMEZONE=Asia/Shanghai
