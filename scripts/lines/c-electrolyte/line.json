{
  "name": "C 公司 A-Lab 电解液产线",
  "note": "氩气手套箱内三段：物料准备段（实验区 7）→ 配液段（实验区 8）→ 测试段（实验区 9），由统一上位机调度机械手、过渡舱等模组；ILCS 编排流程、按步骤下发。模拟阶段全部工位接内置模拟适配器，见 docs/电解液配液线.md。",
  "islands": [
    {"id": 7, "name": "物料准备段"}, {"id": 8, "name": "配液段"}, {"id": 9, "name": "测试段"}
  ],
  "capabilities": [
    {"id": "cap.ely.pick", "name": "机械手取放", "params": {}, "param_specs": {},
     "recovery": {"maxHoldMin": 30, "pausable": true, "retryable": true, "hold": "机械手回安全位，夹爪保持",
                  "sideEffect": "重试前确认夹爪与周转位上没有残留的瓶子", "verify": ["夹爪状态", "周转位占用"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.chamber", "name": "过渡舱转移", "params": {}, "param_specs": {},
     "recovery": {"maxHoldMin": 60, "pausable": true, "retryable": true, "hold": "两侧舱门保持关闭，维持氩气置换",
                  "sideEffect": "重试前确认舱内托盘位置与置换已完成", "verify": ["舱门状态", "舱内氧含量与水含量"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.dose_liquid", "name": "液体称量加注", "params": {"mass": "加注质量"},
     "param_specs": {"mass": {"type": "number", "unit": "g"}},
     "recovery": {"maxHoldMin": 10, "pausable": false, "retryable": false, "hold": "停泵，针头回撤防滴漏",
                  "sideEffect": "已加注的量回收不了，重试会重复加料：按检查点核实实加质量后人工处置",
                  "verify": ["天平读数", "已加注质量"], "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.dose_solid", "name": "固体称量加料", "params": {"mass": "加料质量"},
     "param_specs": {"mass": {"type": "number", "unit": "g"}},
     "recovery": {"maxHoldMin": 10, "pausable": false, "retryable": false, "hold": "停止下料，料斗关闭",
                  "sideEffect": "已加的粉料回收不了，重试会重复加料：按检查点核实实加质量后人工处置",
                  "verify": ["天平读数", "已加料质量"], "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.stir", "name": "控温搅拌", "params": {"temp": "温度", "time": "搅拌时间", "rpm": "转速"},
     "param_specs": {"temp": {"type": "number", "unit": "℃"}, "time": {"type": "number", "unit": "s"},
                     "rpm": {"type": "number", "unit": "rpm"}},
     "recovery": {"maxHoldMin": 30, "pausable": true, "retryable": true, "hold": "停止搅拌，温控保持",
                  "sideEffect": "重试会延长累计搅拌时间", "verify": ["瓶内温度", "搅拌子状态"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.capper", "name": "开关盖", "params": {"torque": "旋盖扭矩"},
     "param_specs": {"torque": {"type": "number", "unit": "N"}},
     "recovery": {"maxHoldMin": 30, "pausable": false, "retryable": true, "hold": "夹爪松开，旋盖头回原位",
                  "sideEffect": "重试前确认瓶盖当前是拧上还是打开", "verify": ["瓶盖状态"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.aliquot", "name": "电解液分装", "params": {"bottles": "分装瓶数", "volume": "每瓶分装量"},
     "param_specs": {"bottles": {"type": "integer", "unit": "瓶"}, "volume": {"type": "number", "unit": "mL"}},
     "recovery": {"maxHoldMin": 15, "pausable": false, "retryable": false, "hold": "停止分液，移液头回撤",
                  "sideEffect": "已分装的瓶子不能再分：按检查点核实已分瓶数后人工处置", "verify": ["已分装瓶数", "母瓶余量"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.conductivity", "name": "电导率检测", "params": {"temp": "测试温度", "repeats": "重复测量次数"},
     "param_specs": {"temp": {"type": "number", "unit": "℃"}, "repeats": {"type": "integer", "unit": "次"}},
     "recovery": {"maxHoldMin": 30, "pausable": false, "retryable": true, "hold": "电极留在样品中，恒温保持",
                  "sideEffect": "重测会多消耗测试瓶里的电解液", "verify": ["电极状态", "样品温度"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.density_viscosity", "name": "密度黏度检测", "params": {"temp": "测试温度", "repeats": "重复测量次数"},
     "param_specs": {"temp": {"type": "number", "unit": "℃"}, "repeats": {"type": "integer", "unit": "次"}},
     "recovery": {"maxHoldMin": 30, "pausable": false, "retryable": true, "hold": "停止进样，测量池恒温",
                  "sideEffect": "重测前确认测量池已清洗、没有气泡", "verify": ["测量池状态", "样品温度"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.raman", "name": "拉曼检测", "params": {"repeats": "重复采谱次数"},
     "param_specs": {"repeats": {"type": "integer", "unit": "次"}},
     "recovery": {"maxHoldMin": 30, "pausable": false, "retryable": true, "hold": "关闭激光，样品留在样品位",
                  "sideEffect": "重复采谱不消耗样品", "verify": ["激光状态", "样品位"],
                  "note": "按物理常识预填，待厂商确认"}},
    {"id": "cap.ely.store", "name": "存储", "params": {}, "param_specs": {},
     "recovery": {"maxHoldMin": 60, "pausable": true, "retryable": true, "hold": "瓶子留在存储位",
                  "sideEffect": "重试前确认存储位是否已放入", "verify": ["存储位占用"],
                  "note": "按物理常识预填，待厂商确认"}}
